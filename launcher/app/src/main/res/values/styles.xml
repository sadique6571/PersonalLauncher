<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:alertDialogTheme">@style/Theme.PersonalDialog</item>
        <item name="android:colorAccent">#40D9FF</item>
        <item name="android:editTextStyle">@style/PersonalDialogInput</item>
        <item name="android:buttonStyle">@style/PersonalDialogButton</item>
    </style>

    <style name="Theme.PersonalDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/personal_glass_panel</item>
        <item name="android:colorBackground">#101F32</item>
        <item name="android:colorAccent">#40D9FF</item>
        <item name="android:textColorPrimary">#F0F7FF</item>
        <item name="android:textColorSecondary">#A4BCD6</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowElevation">14dp</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:listPreferredItemHeightSmall">54dp</item>
        <item name="android:listSelector">@drawable/personal_dialog_button</item>
        <item name="android:editTextStyle">@style/PersonalDialogInput</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PersonalDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PersonalDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PersonalDialogButton</item>
    </style>

    <style name="PersonalDialogInput" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/personal_dialog_button</item>
        <item name="android:textColor">#F0F7FF</item>
        <item name="android:textColorHint">#91ABC5</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="PersonalDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/personal_dialog_button</item>
        <item name="android:textColor">#DDF8FF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
